# Copy to deploy/.env (not committed).

# A long random password, e.g. openssl rand -base64 32
NETCRAWL_DB_PASSWORD=

# How crawlers reach this server: https://<IP of this machine>:8443
# (or https://your-domain). Needed for the install command in the web UI.
NETCRAWL_PUBLIC_URL=

# Port and address the server is published on (default 0.0.0.0:8443).
#NETCRAWL_HTTPS_PORT=8443
#NETCRAWL_BIND=0.0.0.0

NETCRAWL_VERSION=dev
