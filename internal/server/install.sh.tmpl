#!/bin/sh
# NetCrawl crawler installer for crawler "{{.CrawlerID}}", generated by
# netcrawl-server. It installs netcrawl-agent as a systemd service:
#
#   /usr/local/bin/netcrawl-agent      the crawler (checksum verified)
#   /etc/netcrawl-agent/               agent.json + agent.secret
#   /var/lib/netcrawl-agent/           lock file
#   netcrawl-agent.service             runs as the unprivileged user "netcrawl"
#   netcrawl-agent-update (.service/.timer/.path)
#                                      keeps netcrawl-agent at the server's version
#
# The one-time code in this script is valid once and for a short time.
# The release (what the crawler may scan) comes from the server
# registration and is fixed locally in agent.json; only private ranges.
set -eu

SERVER_URL='{{.ServerURL}}'
TLS_PIN='{{.TLSPin}}'
CRAWLER_ID='{{.CrawlerID}}'
SHA256_AMD64='{{.SHA256AMD64}}'
SHA256_ARM64='{{.SHA256ARM64}}'
NETCRAWL_ENROLL_TOKEN='{{.Token}}'

BIN=/usr/local/bin/netcrawl-agent
CONF_DIR=/etc/netcrawl-agent
STATE_DIR=/var/lib/netcrawl-agent
UNIT=/etc/systemd/system/netcrawl-agent.service
SVC_USER=netcrawl

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "please run as root (curl ... | sudo sh)"
[ "$(uname -s)" = Linux ] || die "only Linux is supported"
command -v curl >/dev/null 2>&1 || die "curl is required"
command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
USE_SYSTEMD=1
if [ "${NETCRAWL_NO_SYSTEMD:-}" = 1 ]; then
  USE_SYSTEMD=0
elif ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then
  die "systemd is required (Debian/Ubuntu, Raspberry Pi OS, Proxmox LXC)"
fi

case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64; SUM=$SHA256_AMD64 ;;
  aarch64|arm64) ARCH=arm64; SUM=$SHA256_ARM64 ;;
  *) die "unsupported architecture $(uname -m) (amd64 and arm64 are supported)" ;;
esac
[ -n "$SUM" ] || die "the server has no netcrawl-agent for linux-$ARCH"

# With a self-signed server certificate, curl trusts exactly the pinned key.
fetch() {
  if [ -n "$TLS_PIN" ]; then
    curl -fsS --retry 3 -k --pinnedpubkey "$TLS_PIN" "$@"
  else
    curl -fsS --retry 3 "$@"
  fi
}

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

say "Downloading netcrawl-agent (linux-$ARCH) from $SERVER_URL"
fetch -o "$TMP/netcrawl-agent" "$SERVER_URL/install/agent/linux-$ARCH"
echo "$SUM  $TMP/netcrawl-agent" | sha256sum -c - >/dev/null 2>&1 || die "checksum mismatch, aborting"

# An existing installation is replaced completely: service stopped, old
# configuration, secret, lock and service overrides removed.
if [ -f "$CONF_DIR/agent.json" ] || [ -f "$BIN" ]; then
  OLD_ID=$(sed -n 's/.*"crawler_id": *"\([^"]*\)".*/\1/p' "$CONF_DIR/agent.json" 2>/dev/null | head -n 1)
  say "Replacing the existing installation${OLD_ID:+ (crawler $OLD_ID)}"
  if [ "$USE_SYSTEMD" = 1 ]; then
    systemctl stop netcrawl-agent 2>/dev/null || true
    systemctl reset-failed netcrawl-agent 2>/dev/null || true
  fi
  rm -rf "$CONF_DIR" "$STATE_DIR" /etc/systemd/system/netcrawl-agent.service.d
  if [ -n "$OLD_ID" ] && [ "$OLD_ID" != "$CRAWLER_ID" ]; then
    echo "    Note: this machine was crawler $OLD_ID. Disable it in the web UI if it is no longer used."
  fi
fi
install -m 0755 "$TMP/netcrawl-agent" "$BIN"

if ! getent passwd "$SVC_USER" >/dev/null 2>&1; then
  say "Creating system user $SVC_USER"
  NOLOGIN=$(command -v nologin || echo /usr/sbin/nologin)
  useradd --system --user-group --no-create-home --home-dir /nonexistent --shell "$NOLOGIN" "$SVC_USER"
fi
install -d -m 0750 -o root -g "$SVC_USER" "$CONF_DIR"
install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" "$STATE_DIR"

say "Enrolling crawler $CRAWLER_ID"
export NETCRAWL_ENROLL_TOKEN
if [ -n "$TLS_PIN" ]; then
  "$BIN" enroll --server "$SERVER_URL" --tls-pin "$TLS_PIN" --config-dir "$CONF_DIR" --state-dir "$STATE_DIR" --force
else
  "$BIN" enroll --server "$SERVER_URL" --config-dir "$CONF_DIR" --state-dir "$STATE_DIR" --force
fi
unset NETCRAWL_ENROLL_TOKEN
chown "$SVC_USER:$SVC_USER" "$CONF_DIR/agent.secret"
chmod 0600 "$CONF_DIR/agent.secret"
chown "root:$SVC_USER" "$CONF_DIR/agent.json"
chmod 0640 "$CONF_DIR/agent.json"

if [ "$USE_SYSTEMD" = 0 ]; then
  say "Installed without systemd. Start it with:"
  echo "  runuser -u $SVC_USER -- $BIN --config $CONF_DIR/agent.json"
  exit 0
fi

say "Installing the updater (keeps the crawler at the server's version)"
mkdir -p /usr/local/sbin
cat > /usr/local/sbin/netcrawl-agent-update <<'UPDATER'
{{.Updater}}UPDATER
chmod 0755 /usr/local/sbin/netcrawl-agent-update
# Root-owned: the crawler can't redirect where updates come from.
printf 'SERVER_URL=%s\nTLS_PIN=%s\n' "$SERVER_URL" "$TLS_PIN" > "$CONF_DIR/update.conf"
chmod 0644 "$CONF_DIR/update.conf"
cat > /etc/systemd/system/netcrawl-agent-update.service <<'UNIT'
[Unit]
Description=NetCrawl crawler update (netcrawl-agent)
Documentation=https://github.com/tommic/NetCrawl
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/netcrawl-agent-update
PrivateTmp=yes
ProtectHome=yes
UNIT
cat > /etc/systemd/system/netcrawl-agent-update.timer <<'UNIT'
[Unit]
Description=Check for a new netcrawl-agent every 6 hours

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
UNIT
# The crawler creates this file when the server runs another version.
cat > /etc/systemd/system/netcrawl-agent-update.path <<'UNIT'
[Unit]
Description=Update netcrawl-agent when the crawler asks for it

[Path]
PathExists=/var/lib/netcrawl-agent/update-requested

[Install]
WantedBy=paths.target
UNIT

say "Installing the systemd service"
cat > "$UNIT" <<'UNIT'
[Unit]
Description=NetCrawl crawler (netcrawl-agent)
Documentation=https://github.com/tommic/NetCrawl
After=network-online.target
Wants=network-online.target

[Service]
User=netcrawl
Group=netcrawl
ExecStart=/usr/local/bin/netcrawl-agent --config /etc/netcrawl-agent/agent.json
Restart=on-failure
RestartSec=30
# Exit 3: the server rejects this crawler (reinstalled elsewhere or disabled).
RestartPreventExitStatus=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/netcrawl-agent
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now netcrawl-agent >/dev/null 2>&1 || true
systemctl enable --now netcrawl-agent-update.timer netcrawl-agent-update.path >/dev/null 2>&1 || true
sleep 3

# Some containers (e.g. unprivileged LXC without nesting) cannot set up
# the filesystem sandbox (status 226/NAMESPACE). Fall back to user,
# capability and syscall restrictions only.
if ! systemctl is-active --quiet netcrawl-agent && \
   [ "$(systemctl show -p ExecMainStatus --value netcrawl-agent 2>/dev/null)" = 226 ]; then
  say "Filesystem sandbox not available here (container?), using reduced hardening"
  mkdir -p /etc/systemd/system/netcrawl-agent.service.d
  cat > /etc/systemd/system/netcrawl-agent.service.d/container.conf <<'DROPIN'
[Service]
ProtectSystem=no
ProtectHome=no
ReadWritePaths=
PrivateTmp=no
PrivateDevices=no
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectKernelLogs=no
ProtectControlGroups=no
ProtectClock=no
ProtectHostname=no
RestrictNamespaces=no
DROPIN
  systemctl daemon-reload
  systemctl restart netcrawl-agent
  sleep 3
fi

if systemctl is-active --quiet netcrawl-agent; then
  say "netcrawl-agent is running. It appears as online in the web UI within a minute."
  echo "  Logs:      journalctl -u netcrawl-agent -f"
  echo "  Updates:   automatic (journalctl -u netcrawl-agent-update); off with \"auto_update\": false in $CONF_DIR/agent.json"
  echo "  Uninstall: curl -fsS ${TLS_PIN:+-k --pinnedpubkey '$TLS_PIN' }$SERVER_URL/install/uninstall | sudo sh"
else
  journalctl -u netcrawl-agent -n 20 --no-pager >&2 || true
  die "netcrawl-agent did not start, see the log above"
fi
